[Unit]
Description=Netlayer Admin Worker
After=network.target redis.service mongod.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/netlayer-admin
EnvironmentFile=/opt/netlayer-admin/.env
ExecStart=/usr/bin/node /opt/netlayer-admin/src/worker.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
