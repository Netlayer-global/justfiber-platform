[Unit]
Description=Netlayer Admin Worker
After=network.target redis.service mongod.service

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/justfiber-platform
EnvironmentFile=/opt/justfiber-platform/.env
ExecStart=/usr/bin/node /opt/justfiber-platform/src/worker.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
