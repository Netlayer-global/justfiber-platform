{
  "info": {
    "name": "Justfiber Platform",
    "_postman_id": "5b8df84f-cd0c-4cc7-b6cc-justfiber-platform",
    "description": "Admin, installer, customer, booking and sales APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:4000" },
    { "key": "adminToken", "value": "" },
    { "key": "installerToken", "value": "" },
    { "key": "salesToken", "value": "" },
    { "key": "customerToken", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health/live"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"Netlayer@1411\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/auth/login"
          }
        },
        {
          "name": "Dashboard Executive",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/dashboard/executive"
          }
        },
        {
          "name": "List Installers",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/installers"
          }
        },
        {
          "name": "Sales Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/sales/overview"
          }
        },
        {
          "name": "Billing Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/billing/overview"
          }
        },
        {
          "name": "Billing Invoices",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/billing/invoices"
          }
        },
        {
          "name": "Network Overview",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/network/overview"
          }
        },
        {
          "name": "Network Nodes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/network/nodes"
          }
        }
      ]
    },
    {
      "name": "Installer",
      "item": [
        {
          "name": "Installer Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"9000000001\",\n  \"password\": \"Installer123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/installer/auth/login"
          }
        },
        {
          "name": "Installer Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{installerToken}}" }],
            "url": "{{baseUrl}}/api/v1/installer/dashboard"
          }
        }
      ]
    },
    {
      "name": "Sales",
      "item": [
        {
          "name": "Sales Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"9111111111\",\n  \"password\": \"Sales123!\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/sales/auth/login"
          }
        },
        {
          "name": "Sales Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{salesToken}}" }],
            "url": "{{baseUrl}}/api/v1/sales/dashboard"
          }
        }
      ]
    },
    {
      "name": "Customer",
      "item": [
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"9876543210\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/customer/auth/send-otp"
          }
        },
        {
          "name": "Get Plans",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/customer/plans"
          }
        },
        {
          "name": "Customer Dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/customer/dashboard"
          }
        },
        {
          "name": "Customer Notifications",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/customer/notifications"
          }
        },
        {
          "name": "Customer Add-ons",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/customer/addons"
          }
        },
        {
          "name": "Customer Requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/api/v1/customer/requests"
          }
        }
      ]
    }
  ]
}
